{
  "name": "tektite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual:compare": "node scripts/visual-parity/compare.mjs",
    "visual:compare-dom": "node scripts/visual-parity/compare-dom.mjs",
    "visual:compare-regions": "node scripts/visual-parity/compare-regions.mjs",
    "test:e2e": "bddgen && playwright test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "dompurify": "^3.4.13",
    "effect": "^3.22.1",
    "highlight.js": "^11.11.1",
    "hono": "^4.13.1",
    "honox": "^0.1.60",
    "katex": "^0.18.1",
    "marked": "^18.0.9",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.62.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pixelmatch": "^7.2.0",
    "playwright-bdd": "^9.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
